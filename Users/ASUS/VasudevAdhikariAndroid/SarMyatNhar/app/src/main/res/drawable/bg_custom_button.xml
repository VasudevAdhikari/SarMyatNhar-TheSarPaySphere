<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/secondaryColor"
                android:centerColor="@color/accentColor"
                android:endColor="@color/primaryColor"
                android:type="linear" />
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <!-- Default State -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/primaryColor"
                android:centerColor="@color/secondaryColor"
                android:endColor="@color/accentColor"
                android:type="linear" />
            <corners android:radius="16dp"/>
        </shape>
    </item>

</selector>
